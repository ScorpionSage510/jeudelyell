{
  "manifest_version": 2,
  "name": "Défi Lyell",
  "version": "1.0",
  "description": "Ajoute des fonctionnalités d'aide pour le Défi Géologique de Lyell (mode invincible, affichage réponse, comparateur).",

  "icons": {
    "16": "icons/icon16.png",    
    "48": "icons/icon48.png"
  },

  "permissions": [
    "activeTab"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.pedagogie.ac-nice.fr/svt/productions/defi-lyell/"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}